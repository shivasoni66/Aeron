# ==============================================================================
# AERON BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection URI (Local dev or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/aeron_dev

# JWT Authentication Configuration
JWT_SECRET=aeron_super_secret_jwt_key_development_only_min_32_chars
JWT_ISSUER=aeron-auth
JWT_AUDIENCE=aeron-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Allowed CORS Origins (Comma-separated for multiple origins)
# Production domains must strictly follow the mandatory 'aeron-' subdomain prefix convention
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://aeron-admin.sharprad-x.tech,https://aeron-manager.sharprad-x.tech

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Machine-to-Machine Drone Bridge Ingestion Token (Telemetry)
DRONE_BRIDGE_TOKEN=your_secure_drone_bridge_token_here

# Machine-to-Machine Camera Bridge Ingestion Token (ESP32-CAM)
CAMERA_BRIDGE_TOKEN=your_secure_camera_bridge_token_here

# ==============================================================================
# DURABLE PERSISTENT MEDIA STORAGE CONFIGURATION
# ==============================================================================
# Storage Provider: LOCAL | CLOUDINARY | S3
# In production (NODE_ENV=production), set to CLOUDINARY or S3.
STORAGE_PROVIDER=CLOUDINARY

# Cloudinary Configuration (Recommended durable cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=

# Amazon S3 / Compatible Object Storage (Alternative)
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


