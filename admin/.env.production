# ==============================================================================
# AERON Admin Web — Production Configuration
# ==============================================================================

# Central Backend Production URL
VITE_API_BASE_URL=https://aeron.onrender.com
VITE_SOCKET_URL=https://aeron.onrender.com

# Remote Camera Architecture:
# In remote production contexts, the operator's browser cannot access private 
# hotspot IPs (e.g. 10.231.241.200). 'relay' uses the secure Python Bridge -> 
# Render Backend -> Socket.IO streaming pipeline.
VITE_CAMERA_MODE=relay
