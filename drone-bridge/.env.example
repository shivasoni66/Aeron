# ==============================================================================
# AERON DRONE BRIDGE & PIXHAWK 2.4.8 MAVLINK TELEMETRY CONFIGURATION
# ==============================================================================

# Dual-Transport MAVLink Configuration (Wi-Fi Station Mode + USB)
AERON_TELEMETRY_TRANSPORT=dual
AERON_PRIMARY_TRANSPORT=wifi
AERON_WIFI_HOST=auto
AERON_WIFI_PORT=5760
AERON_WIFI_FALLBACK_IP=192.168.4.1
AERON_WIFI_UDP_PORT=37020
AERON_USB_PORT=COM8
AERON_USB_BAUD=115200

# Legacy MAVLink Connection Fallbacks:
# On Windows, set COM port (e.g. COM8) or TCP/UDP endpoint (e.g. udpin:localhost:14550)
MAVLINK_CONNECTION=COM8
MAVLINK_BAUD=115200
MAVLINK_SOURCE=REAL

# Airframe Identification
DRONE_ID=AERON-PX4-BENCH01

# Backend Ingestion Endpoints (Local or Render Deployed)
# Local:  http://localhost:5000/api/v1
# Render: https://aeron.onrender.com/api/v1
AERON_BACKEND_URL=http://localhost:5000/api/v1
BACKEND_INGEST_URL=http://localhost:5000/api/v1/telemetry/ingest

# Machine-to-Machine Secret Authentication Token
DRONE_BRIDGE_TOKEN=aeron_drone_bridge_secret_token_dev

# Rate and Freshness Tuning
TELEMETRY_PERSIST_INTERVAL_MS=250
HEARTBEAT_TIMEOUT_SECONDS=3.0
QUEUE_MAX_SIZE=500

# Software Simulation Fallback (Set to true only when running pure simulated bench tests)
SIMULATOR_ENABLED=false
SIMULATOR_RATE_HZ=10.0

# Logging Level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# ESP32-CAM Optical Payload Configuration (AI-Thinker OV2640 on Mobile Hotspot)
CAMERA_ENABLED=false
CAMERA_DEVICE_ID=ESP32-CAM-01
CAMERA_HOST=10.231.241.200
CAMERA_PORT=81
CAMERA_PROTOCOL=MJPEG
CAMERA_STREAM_PATH=/stream
CAMERA_SNAPSHOT_PATH=/capture
CAMERA_TARGET_FPS=5
