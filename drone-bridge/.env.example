# ==============================================================================
# AERON DRONE BRIDGE & PIXHAWK 2.4.8 MAVLINK TELEMETRY CONFIGURATION
# ==============================================================================

# Hardware MAVLink Connection:
# On Windows, set COM port (e.g. COM9, COM8) or TCP/UDP endpoint (e.g. udpin:localhost:14550)
MAVLINK_CONNECTION=COM9
MAVLINK_BAUD=57600
MAVLINK_SOURCE=REAL

# Airframe Identification
DRONE_ID=AERON-PX4-BENCH01

# Backend Ingestion Endpoints (Local or Render Deployed)
# Local: http://localhost:5000/api/v1
# Render: https://aeron-api.sharprad-x.tech/api/v1
AERON_BACKEND_URL=http://localhost:5000/api/v1
BACKEND_INGEST_URL=http://localhost:5000/api/v1/telemetry/ingest

# Machine-to-Machine Secret Authentication Token
DRONE_BRIDGE_TOKEN=aeron_drone_bridge_secret_token_dev

# Rate and Freshness Tuning
TELEMETRY_PERSIST_INTERVAL_MS=250
HEARTBEAT_TIMEOUT_SECONDS=3.0
QUEUE_MAX_SIZE=500

# Software Simulation Fallback (Set to true only when running pure simulated bench tests)
SIMULATOR_ENABLED=false
SIMULATOR_RATE_HZ=10.0

# Logging Level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO
